{
	"name": "deployer-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "bun run i18n:types && vite",
		"build": "bun run i18n:types && vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"i18n:types": "bun scripts/generate-i18n-schema.ts",
		"dev:db:introspect": "drizzle-kit introspect --dialect=sqlite --out=./drizzle --url=./drizzle/dev.sqlite --introspect-casing=preserve",
		"dev:db:create": "sqlx database drop -y -D=sqlite:./drizzle/dev.sqlite && sqlx database create -D=sqlite:./drizzle/dev.sqlite",
		"dev:db:migrate": "sqlx migrate run --database-url=sqlite:./drizzle/dev.sqlite --source=./src-tauri/migrations/",
		"dev:db:copy-schema": "bun scripts/copy-drizzle-schema.ts",
		"dev:db:generate": "bun run dev:db:create && bun run dev:db:migrate && bun run dev:db:introspect && bun run dev:db:copy-schema"
	},
	"dependencies": {
		"@nuxt/ui": "^4.9.0",
		"@pinia/colada": "^1.3.1",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "~2.7.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-positioner": "~2.3.2",
		"@tauri-apps/plugin-sql": "~2.4.0",
		"@tauri-apps/plugin-store": "~2.4.3",
		"@tauri-apps/plugin-window-state": "~2.4.1",
		"@vueuse/core": "^14.3.0",
		"drizzle-orm": "^0.45.2",
		"maska": "^3.2.0",
		"prettier-plugin-organize-imports": "^4.3.0",
		"sortablejs": "^1.15.7",
		"vue": "^3.5.39",
		"vue-i18n": "^11.4.6",
		"vue-router": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^25.9.4",
		"@types/sortablejs": "^1.15.9",
		"@vitejs/plugin-vue": "^6.0.7",
		"drizzle-kit": "^0.31.10",
		"tailwindcss": "^4.3.2",
		"typescript": "~6.0.3",
		"vite": "^8.1.3",
		"vite-plugin-vue-devtools": "^8.1.5",
		"vue-tsc": "^3.3.6"
	}
}
