{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "DeployerApp",
	"version": "0.1.0",
	"identifier": "com.idmarinas.deployer-app",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "DeployerApp",
				"width": 1400,
				"height": 900,
				"minWidth": 800,
				"minHeight": 800,
				"center": true,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"copyright": "Copyright (c) 2026-present IDMarinas",
		"category": "DeveloperTool",
		"publisher": "IDMarinas",
		"active": true,
		"targets": "nsis",
		"windows": {
			"nsis": {
				"installerIcon": "icons/installer.ico",
				"uninstallerIcon": "icons/uninstaller.icon",
				"installMode": "both",
				"languages": ["Spanish", "English"]
			}
		},
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
